# Copy this file to .env and fill in real values.

# Postgres/TimescaleDB connection (matches docker-compose defaults for local dev)
DATABASE_URL=postgresql+psycopg://grid:grid@localhost:5432/grid_copilot

# Anthropic API key, used for the RAG generation step (grid ops recommendations)
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for RAG-grounded recommendations
CLAUDE_MODEL=claude-sonnet-5

# Local embedding model (sentence-transformers), no external API key required
EMBEDDING_MODEL=all-MiniLM-L6-v2

# EIA API key (free, https://www.eia.gov/opendata/register.php), used to
# ingest real California (CISO) grid demand data. Without it, the "california"
# region is skipped during seeding rather than erroring.
EIA_API_KEY=

# Slack incoming webhook URL (https://api.slack.com/apps -> Incoming Webhooks),
# used to page a human when the surge watcher detects a demand surge. Without
# it, surge events are still created, just not announced anywhere.
SLACK_WEBHOOK_URL=

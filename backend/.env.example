# Copy this file to .env and fill in real values.

# Postgres/TimescaleDB connection (matches docker-compose defaults for local dev)
DATABASE_URL=postgresql+psycopg://grid:grid@localhost:5432/grid_copilot

# Anthropic API key, used for the RAG generation step (grid ops recommendations)
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for RAG-grounded recommendations
CLAUDE_MODEL=claude-sonnet-5

# Local embedding model (sentence-transformers), no external API key required
EMBEDDING_MODEL=all-MiniLM-L6-v2

# EIA API key (free, https://www.eia.gov/opendata/register.php), used to
# ingest real California (CISO) grid demand data. Without it, the "california"
# region is skipped during seeding rather than erroring.
EIA_API_KEY=

# Slack incoming webhook URL (https://api.slack.com/apps -> Incoming Webhooks),
# used to page a human when the surge watcher detects a demand surge. Without
# it, surge events are still created, just not announced anywhere.
SLACK_WEBHOOK_URL=

# Twilio (https://twilio.com/try-twilio, free trial, no card required) —
# SMS paging for surge events, alongside Slack. All four must be set for SMS
# to send; missing any of them just means SMS is skipped (same "configured
# or not" contract as SLACK_WEBHOOK_URL). Trial accounts can only send to a
# verified number, which is enough for a personal demo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# Set AUTH_REQUIRED=true before exposing the backend outside local development.
# Store both long random values in your platform's secret manager, never in
# the frontend bundle. Admin keys may ingest documents; operator keys may use
# recommendations, monitoring, feedback, and surge-review endpoints.
AUTH_REQUIRED=false
OPERATOR_API_KEY=
ADMIN_API_KEY=
